     /// icon.
     @MainActor
     static func appIcon(for item: MenuBarItem) -> NSImage? {
+        if let name = systemSymbolName(for: item) {
+            if let image = systemSymbols[name] {
+                return image
+            }
+            let configuration = NSImage.SymbolConfiguration(paletteColors: [.labelColor])
+            if let image = NSImage(systemSymbolName: name, accessibilityDescription: item.displayName)?
+                .withSymbolConfiguration(configuration)
+            {
+                image.isTemplate = true
+                systemSymbols[name] = image
+                return image
+            }
+        }
