         }
     }
+
+    /// These identify a function rather than reporting its current state.
+    @MainActor
+    private static func systemSymbolName(for item: MenuBarItem) -> String? {
+        switch item.tag.namespace {
+        case .textInputMenuAgent:
+            return "keyboard"
+        case .controlCenter, .systemUIServer:
+            switch item.tag.title {
+            case "WiFi": return "wifi"
+            case "Battery": return "battery.0"
+            case "Clock": return "clock"
+            default: return nil
+            }
+        default:
+            return nil
+        }
+    }
 }
