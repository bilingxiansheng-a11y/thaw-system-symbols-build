+    @Test("Cached system symbols remain visible in light and dark settings")
+    func cachedSystemSymbolsFollowAppearance() throws {
+        let item = item(namespace: .controlCenter, title: "WiFi", sourcePID: nil)
+        let image = try #require(MenuBarItemIconFallback.appIcon(for: item))
+        let light = try symbolBrightness(image, appearance: .aqua)
+        let dark = try symbolBrightness(image, appearance: .darkAqua)
+        #expect(light < 0.2)
+        #expect(dark > 0.8)
