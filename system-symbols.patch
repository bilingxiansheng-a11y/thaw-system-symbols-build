+
+    private func symbolBrightness(_ image: NSImage, appearance name: NSAppearance.Name) throws -> Double {
+        let appearance = try #require(NSAppearance(named: name))
+        let bitmap = try #require(NSBitmapImageRep(
+            bitmapDataPlanes: nil, pixelsWide: 32, pixelsHigh: 32,
+            bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
+            colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0
+        ))
+        let context = try #require(NSGraphicsContext(bitmapImageRep: bitmap))
+        appearance.performAsCurrentDrawingAppearance {
+            NSGraphicsContext.saveGraphicsState()
+            defer { NSGraphicsContext.restoreGraphicsState() }
+            NSGraphicsContext.current = context
+            NSColor.clear.setFill()
+            NSRect(x: 0, y: 0, width: 32, height: 32).fill(using: .copy)
+            NSColor.secondaryLabelColor.set()
+            image.draw(in: NSRect(x: 2, y: 2, width: 28, height: 28), from: .zero, operation: .sourceOver, fraction: 1)
+        }
+        var weightedRed = 0.0
+        var alpha = 0.0
+        for x in 0 ..< 32 {
+            for y in 0 ..< 32 {
+                let color = try #require(bitmap.colorAt(x: x, y: y)?.usingColorSpace(.deviceRGB))
+                weightedRed += color.redComponent * color.alphaComponent
+                alpha += color.alphaComponent
+            }
+        }
+        #expect(alpha > 0)
+        return weightedRed / max(alpha, 1)
+    }
